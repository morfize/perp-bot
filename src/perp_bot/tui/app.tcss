/* Perp Bot TUI Layout */

Screen {
    layout: grid;
    grid-size: 2 4;
    grid-rows: 1 1fr 1fr 1fr;
    grid-columns: 1fr 1fr;
}

HeaderWidget {
    column-span: 2;
    height: 1;
    background: $surface;
}

PositionWidget {
    border: solid $primary;
    padding: 0 1;
    height: 100%;
}

SignalsWidget {
    border: solid $primary;
    padding: 0 1;
    height: 100%;
}

RiskWidget {
    border: solid $primary;
    padding: 0 1;
    height: 100%;
}

TradesWidget {
    border: solid $primary;
    height: 100%;
}

LogWidget {
    column-span: 2;
    border: solid $accent;
    height: 100%;
}

Footer {
    column-span: 2;
}
